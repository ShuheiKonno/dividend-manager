{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json,subprocess;d=json.load(sys.stdin);p=d.get('file_path','');p.endswith('.py') and [subprocess.run(['ruff','check','--fix',p],capture_output=True),subprocess.run(['ruff','format',p],capture_output=True)]\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json;d=json.load(sys.stdin);p=d.get('file_path','').replace('\\\\\\\\','/').replace('\\\\','/');parts=p.split('/');sys.exit(1 if 'data' in parts and p.endswith('.csv') else 0)\""
          }
        ]
      }
    ]
  }
}
